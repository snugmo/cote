FROM scratch AS bun-artifacts
COPY --from=bun-bin /usr/local/bin/bun /usr/local/bin/

# =============================================================================
# GO — install
# =============================================================================
FROM scratch AS go-download-amd64
ARG TARGETARCH
ARG GO_VERSION
ADD --checksum=sha256:65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40 \
    https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz /download/go.tar.gz

FROM scratch AS go-download-arm64
ARG TARGETARCH
ARG GO_VERSION
ADD --checksum=sha256:a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49 \
    https://go.dev/dl/go${GO_VERSION}.linux-arm64.tar.gz /download/go.tar.gz

# hadolint ignore=DL3006
FROM go-download-${TARGETARCH} AS go-download

FROM downloader AS go-install
ARG GO_VERSION
ENV GO_VERSION=${GO_VERSION} \
    GOPATH=/go \
    PATH=/go/bin:/opt/go/bin:$PATH

COPY --from=go-download /download/go.tar.gz /download/go.tar.gz
RUN tar -C /opt -xzf /download/go.tar.gz

# Go tools intentionally track latest module versions via @latest
# hadolint ignore=DL3062
RUN mkdir -p $GOPATH/bin && \
    go install golang.org/x/tools/gopls@latest && \
    go install github.com/nametake/golangci-lint-langserver@latest && \
    # golangci-lint v2+ is a /v2 module; the path suffix is required or @latest silently resolves to the old v1 line
    go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest && \
    rm -rf $GOPATH/pkg

FROM scratch AS go-artifacts
COPY --from=go-install /opt/go /opt/go/
COPY --from=go-install --chown=1000:1000 /go /go/

