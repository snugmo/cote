# Base development environment image for DevWorkspaces Operator
# Provides universal toolchain: compilers, package managers, shell utils, LSP servers
# IDEs are excluded — they are added as separate Devfile components (e.g., Eclipse Che plugins)
#
# Build strategy: parallel install stages → scratch artifact stages → final assembly.
# Each toolchain installs to standard paths, then a FROM scratch stage captures
# only the files needed. Final image assembles via single COPY --link per toolchain.

# =============================================================================
# BASE — system packages only (rarely changes)
# =============================================================================
FROM registry.fedoraproject.org/fedora:44 AS base

# Prevent interactive prompts during package installation
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    FORCE_NONINTERACTIVE=1

RUN mkdir -p /etc/yum.repos.d && \
    dnf install --setopt=install_weak_deps=false --nodocs --setopt=tsflags=nodocs -y \
        dnf-plugins-core && \
    # Reinstall shadow-utils to fix file caps on newuidmap, newgidmap
    dnf reinstall -y shadow-utils && \
    dnf install --setopt=install_weak_deps=false --nodocs --setopt=tsflags=nodocs -y \
        # Base shell tools
        diffutils findutils lsof moreutils openssl patch procps time util-linux which \
        # Build tools
        bison byacc clang clang-libs clang-tools-extra cmake flex gcc gcc-c++ gdb llvm make meson m4 ninja-build xxd \
        # Shells & editors
        bash bash-completion bash-color-prompt fish nano vim vim-default-editor zsh \
        # Version control & collaboration
        git git-annex git-delta git-filter-repo git-lfs \
        # HTTP & download tools
        curl openssh-clients wget wget2 \
        # Text processing & utilities
        bat file gawk jq less sed strace tree \
        # Python ecosystem
        python3 python3-devel python3-pip python3-wheel \
        # Rust
        rustup \
        # Language servers & search tools
        fd-find ripgrep the_silver_searcher yq \
        # Identity, encryption, integrity
        age ca-certificates gnupg2 gpgme sequoia-sop sequoia-sq \
        # Misc dev utilities
        7zip gzip tar tmux unzip xdelta xz xxhash zstd \
        # Network tools
        bind-utils grpcurl iproute iputils knot-utils net-tools nmap nmap-ncat oidc-agent-cli socat tcpdump \
        # Markdown renderer
        glow \
        # Image tools
        ImageMagick GraphicsMagick libsixel-utils \
        # Container tools
        podman buildah skopeo fuse-overlayfs \
        # Kubernetes utilities
        kustomize helm kubernetes1.36-client awscli2 opentofu \
        # Misc extras
        foot-terminfo kitty-terminfo \
    && dnf clean all

# =============================================================================
# CRUSH — install
# =============================================================================
FROM base AS crush-install
COPY <<-'EOT' /etc/yum.repos.d/charm.repo
	[charm]
	name=Charm
	baseurl=https://repo.charm.sh/yum/
	enabled=1
	gpgcheck=1
	gpgkey=https://repo.charm.sh/yum/gpg.key
EOT
RUN dnf install --setopt=install_weak_deps=false --nodocs --setopt=tsflags=nodocs -y crush && \
    dnf clean all

FROM scratch AS crush-artifacts
COPY --from=crush-install /usr/bin/crush /usr/bin/
COPY --from=crush-install /etc/yum.repos.d/charm.repo /etc/yum.repos.d/

# =============================================================================
# NODEJS — install
# =============================================================================
FROM base AS nodejs-install
RUN curl -fsSL https://rpm.nodesource.com/setup_22.x | bash - && \
    dnf install --setopt=install_weak_deps=false --nodocs --setopt=tsflags=nodocs -y nodejs && \
    dnf clean all && \
    npm install -g \
        typescript \
        typescript-language-server \
        eslint \
        prettier \
        yaml-language-server

FROM scratch AS nodejs-artifacts
COPY --from=nodejs-install /usr/bin/node /usr/bin/
COPY --from=nodejs-install /usr/bin/npm /usr/bin/
COPY --from=nodejs-install /usr/bin/npx /usr/bin/
COPY --from=nodejs-install /usr/lib/node_modules /usr/lib/node_modules/

# =============================================================================
# BUN — install
# =============================================================================
FROM base AS bun-install
RUN curl -fsSL https://bun.sh/install | bash -

FROM scratch AS bun-artifacts
COPY --from=bun-install /root/.bun/bin/bun /usr/local/bin/
COPY --from=bun-install /root/.bun/bin/bunx /usr/local/bin/

# =============================================================================
# GO — install
# =============================================================================
FROM base AS go-install
ARG GO_VERSION=1.26.3
ENV GO_VERSION=${GO_VERSION} \
    GOPATH=/go \
    PATH=/go/bin:/usr/local/go/bin:$PATH

RUN curl -fsSL "https://golang.org/dl/go${GO_VERSION}.linux-amd64.tar.gz" | \
    tar -C /usr/local -xz && \
    mkdir -p $GOPATH/bin && \
    go install golang.org/x/tools/gopls@latest && \
    go install github.com/nametake/golangci-lint-langserver@latest

FROM scratch AS go-artifacts
COPY --from=go-install /usr/local/go /usr/local/go/
COPY --from=go-install /go /go/

# =============================================================================
# RUST — install
# =============================================================================
FROM base AS rust-install
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN rustup-init -y --profile=default --default-toolchain stable && \
    rustup component add rust-analyzer

FROM scratch AS rust-artifacts
COPY --from=rust-install /usr/local/rustup /usr/local/rustup/
COPY --from=rust-install /usr/local/cargo /usr/local/cargo/

# =============================================================================
# PYTHON — install
# =============================================================================
FROM base AS python-install
RUN pip3 install --no-cache-dir --break-system-packages \
    pylint \
    black \
    ruff \
    mypy \
    pyright \
    ruff-lsp

FROM scratch AS python-artifacts
COPY --from=python-install /usr/lib64/python3*/site-packages /usr/lib64/python3*/site-packages/
COPY --from=python-install /usr/local/bin/ /usr/local/bin/

# =============================================================================
# FINAL — assemble all toolchains into workspace image
# =============================================================================
FROM base AS final

# Assemble toolchains from artifact stages
COPY --link --from=crush-artifacts / /
COPY --link --from=nodejs-artifacts / /
COPY --link --from=bun-artifacts / /
COPY --link --from=go-artifacts / /
COPY --link --from=rust-artifacts / /
COPY --link --from=python-artifacts / /

# Go env
ARG GO_VERSION=1.26.3
ENV GO_VERSION=${GO_VERSION} \
    GOPATH=/go \
    PATH=/go/bin:/usr/local/go/bin:$PATH

# Rust env
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

# =============================================================================
# Workspace user (DevWorkspaces runs as non-root)
# =============================================================================
RUN useradd -m -u 1000 -U -s /bin/bash user && \
    mkdir -p /projects /home/user/.local /home/user/.config /home/user/.ssh \
             /go /usr/local/cargo /usr/local/rustup && \
    chown -R user:user /home/user /go /usr/local/cargo /usr/local/rustup

# Fixes for allowing rootless buildah and podman inside the container
RUN sed -i -e '/^user:/d' /etc/subuid /etc/subgid && \
    usermod --add-subuids 2000-65000 --add-subgids 2000-65000 user
ENV _BUILDAH_STARTED_IN_USERNS="" BUILDAH_ISOLATION=chroot

USER user
ENV PATH="/home/user/.local/bin:$PATH"
WORKDIR /projects
ENTRYPOINT ["/usr/libexec/podman/catatonit","--"]
CMD ["tail", "-f", "/dev/null"]

LABEL name="dev-workspace-base" \
      description="Base development environment for agentic developer workspaces" \
      maintainer="Joakim Nohlgård" \
      io.openshift.tags="dev,workspace,toolchain"
