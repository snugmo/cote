# Base development environment image for DevWorkspaces Operator
# Provides universal toolchain: compilers, package managers, shell utils, LSP servers
# IDEs are excluded — they are added as separate Devfile components (e.g., Eclipse Che plugins)
#
# Build strategy: per-arch download stages → parallel install stages → scratch artifact stages → final assembly.
# Each toolchain installs to standard paths, then a FROM scratch stage captures
# only the files needed. Final image assembles via single COPY --link per toolchain.

ARG TARGETARCH
# Pinned tool versions for the per-arch download stages (overridable at build)
ARG GO_VERSION=1.27.3
ARG UV_VERSION=0.13.5
ARG GH_VERSION=2.103.1
ARG KUBECTL_LINSTOR_VERSION=0.3.2
ARG AGENTGATEWAY_VERSION=1.6.0
ARG MARKSMAN_VERSION=2026-02-08
ARG HELM_LS_VERSION=0.5.4
ARG TOFU_LS_VERSION=0.5.3
ARG PROTOLS_VERSION=0.7.4
ARG HERDR_VERSION=0.9.5
ARG AST_GREP_VERSION=0.51.0
ARG SHFMT_VERSION=3.14.1
ARG KUBECONFORM_VERSION=0.8.0
ARG SIMPLEX_CHAT_VERSION=7.0.3
ARG NONO_VERSION=0.80.0

# Cosign binary from upstream image (defined first so downloader can reference it)
FROM ghcr.io/sigstore/cosign/cosign:v3.1.4 AS cosign-bin

# =============================================================================
# DOWNLOADER — curl-only base for download-based install stages
# =============================================================================
FROM docker.io/curlimages/curl@sha256:11e64e28c5f58c8d93ee95fcf22ac055f48b0bc440e0ce7d8013bbb5ad6aa8ac AS downloader
# Intermediate stage only: root needed to place cosign in /usr/local/bin for
# verification steps. `root` (and `user` below) exist in every cote image, so
# DL3066's host-resolution concern is a false positive here.
# hadolint ignore=DL3002,DL3066
USER root
COPY --from=cosign-bin /ko-app/cosign /usr/local/bin/cosign

# =============================================================================
# BASE — system packages only (rarely changes)
# =============================================================================
FROM registry.fedoraproject.org/fedora:45 AS base

# Set locale to C to avoid warnings about missing translations
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8
# Prevent interactive prompts during package installation
ARG FORCE_NONINTERACTIVE=1

# Base image tracks the Fedora 45 distro package set; per-package version pins are intentional out-of-scope
# hadolint ignore=DL3041
RUN mkdir -p /etc/yum.repos.d && \
    dnf install --setopt=install_weak_deps=false --nodocs --setopt=tsflags=nodocs -y \
        dnf-plugins-core && \
    # Reinstall shadow-utils to fix file caps on newuidmap, newgidmap
    dnf reinstall -y shadow-utils && \
    dnf install --setopt=install_weak_deps=false --nodocs --setopt=tsflags=nodocs -y \
        # Base shell tools
        diffutils findutils lsof moreutils openssl patch procps time util-linux which \
        # Build tools
        bison byacc clang clang-libs clang-tools-extra cmake flex gcc gcc-c++ gdb llvm make meson m4 ninja-build \
        # Protobuf
        protobuf protobuf-c protobuf-compiler protobuf-devel \
        # Shells & editors
        bash bash-completion bash-color-prompt fish nano vim vim-default-editor zsh \
        # Version control & collaboration
        git git-annex git-delta git-filter-repo git-lfs \
        # HTTP & download tools
        curl openssh-clients openssh-server wget wget2 \
        # Text processing & utilities
        bat gawk jq less sed xmlstarlet xq xxd yq \
        # Python ecosystem
        python3 python3-devel python3-pip python3-wheel \
        # Rust
        rustup \
        # Language servers & search tools
        fd-find file hadolint ripgrep shellcheck the_silver_searcher tree \
        # Identity, encryption, integrity
        age ca-certificates gnupg2 gpgme openssl3-devel openssl3-devel-engine sequoia-sop sequoia-sq \
        # Misc dev utilities
        7zip gzip rsync sqlite strace tar tmux unzip xdelta xz xxhash zip zstd \
        # Network tools
        bind-utils grpcurl iproute iputils knot-utils net-tools nmap nmap-ncat oidc-agent-cli socat slirp4netns tcpdump \
        # Markdown renderer
        glow \
        # Image tools
        ImageMagick GraphicsMagick exif exiv2 librsvg2-tools libsixel-utils potrace \
        # Container tools
        podman buildah skopeo bubblewrap bwrap-oci fuse-overlayfs \
        # Kubernetes utilities
        kustomize helm kubernetes1.36-client awscli2 opentofu \
        # Misc extras
        foot-terminfo kitty-terminfo \
    && dnf clean all

# Fedora 45 ships dnf5: the adoptium repo definition lands in
# /usr/share/dnf5/repos.d and fedora-third-party enables it through
# /etc/dnf/repos.override.d. Its baseurl uses $releasever, but Adoptium
# only publishes RPMs up to the fedora/44 release dir, so pin it with a
# second override file (verified: maven and both Temurin JDKs install).
# hadolint ignore=DL3041
RUN dnf install --setopt=install_weak_deps=false --nodocs --setopt=tsflags=nodocs -y \
        adoptium-temurin-java-repository.noarch \
    && fedora-third-party enable \
    && printf '%s\n' \
        "[adoptium-temurin-java-repository]" \
        "baseurl=https://packages.adoptium.net/artifactory/rpm/fedora/44/\$basearch" \
        > /etc/dnf/repos.override.d/10-adoptium-pin.repo \
    && dnf install --setopt=install_weak_deps=false --nodocs --setopt=tsflags=nodocs -y \
        maven \
        temurin-21-jdk \
        temurin-25-jdk \
    && dnf clean all

# Java env
ENV JAVA_HOME=/usr/lib/jvm/java-25-temurin-jdk \
    JAVA21_HOME=/usr/lib/jvm/java-21-temurin-jdk

# Copy cosign binary from upstream image
COPY --from=cosign-bin /ko-app/cosign /usr/local/bin/cosign

# =============================================================================
# CRUSH — install from GitHub release with cosign verification
# =============================================================================
FROM downloader AS crush-install
ARG TARGETARCH
ARG CRUSH_VERSION=0.98.2
RUN if [ "$TARGETARCH" = "amd64" ]; then ARCH=x86_64; else ARCH=aarch64; fi && \
    curl -fsSL "https://github.com/charmbracelet/crush/releases/download/v${CRUSH_VERSION}/crush_${CRUSH_VERSION}_Linux_${ARCH}.tar.gz" -o crush.tar.gz && \
    curl -fsSL "https://github.com/charmbracelet/crush/releases/download/v${CRUSH_VERSION}/checksums.txt" -o checksums.txt && \
    curl -fsSL "https://github.com/charmbracelet/crush/releases/download/v${CRUSH_VERSION}/checksums.txt.sigstore.json" -o checksums.txt.sigstore.json && \
    # Crush releases moved from the meta repo's goreleaser workflow to a
    # per-tag release workflow in the crush repo (0.98.1)
    cosign verify-blob \
      --certificate-identity 'https://github.com/charmbracelet/crush/.github/workflows/release.yml@refs/tags/v'"${CRUSH_VERSION}" \
      --certificate-oidc-issuer 'https://token.actions.githubusercontent.com' \
      --bundle checksums.txt.sigstore.json \
      checksums.txt && \
    EXPECTED=$(awk -v f="crush_${CRUSH_VERSION}_Linux_${ARCH}.tar.gz" '$0 ~ (f "$") { print $1; exit }' checksums.txt) && \
    printf '%s\n' "${EXPECTED}  crush.tar.gz" > expected.sum && \
    sha256sum -c expected.sum && rm -f expected.sum && \
    mkdir -p /etc/bash_completion.d /usr/share/fish/vendor_completions.d /usr/share/zsh/site-functions && \
    tar -xzf crush.tar.gz -C /tmp --strip-components=1 && \
    mv /tmp/crush /usr/local/bin/crush && \
    cp /tmp/completions/crush.bash /etc/bash_completion.d/crush && \
    cp /tmp/completions/crush.fish /usr/share/fish/vendor_completions.d/crush.fish && \
    cp /tmp/completions/crush.zsh /usr/share/zsh/site-functions/_crush && \
    rm -rf /tmp/crush /tmp/completions && \
    rm -f crush.tar.gz checksums.txt checksums.txt.sigstore.json

FROM scratch AS crush-artifacts
COPY --from=crush-install /usr/local/bin/crush /usr/local/bin/
COPY --from=crush-install /etc/bash_completion.d/crush /etc/bash_completion.d/
COPY --from=crush-install /usr/share/fish/vendor_completions.d/crush.fish /usr/share/fish/vendor_completions.d/
COPY --from=crush-install /usr/share/zsh/site-functions/_crush /usr/share/zsh/site-functions/

# =============================================================================
# NODEJS — install
# =============================================================================
FROM base AS nodejs-install
ARG TARGETARCH
ARG FNM_VERSION=1.39.0
ARG NODE_VERSION=26
ENV FNM_DIR=/opt/fnm
ENV PATH=${FNM_DIR}:$PATH

RUN if [ "$TARGETARCH" = "arm64" ]; then ARCH=arm64; else ARCH=linux; fi && \
    mkdir -p "${FNM_DIR}" && \
    curl -fsSL "https://github.com/Schniz/fnm/releases/download/v${FNM_VERSION}/fnm-${ARCH}.zip" -o fnm.zip && \
    unzip -q fnm.zip -d "${FNM_DIR}" && \
    rm -f fnm.zip

RUN "${FNM_DIR}/fnm" install "${NODE_VERSION}" && \
    "${FNM_DIR}/fnm" default "${NODE_VERSION}"

# LSP servers and JS tooling intentionally track latest npm releases;
# separate RUNs keep the stable fnm layers cached while the npm layer churns
# hadolint ignore=DL3016,DL3059
RUN bash -c 'source <("${FNM_DIR}/fnm" env --shell bash) && \
    npm install -g \
        bash-language-server \
        dockerfile-language-server-nodejs \
        eslint \
        prettier \
        pnpm \
        typescript \
        typescript-language-server \
        yaml-language-server'

FROM scratch AS nodejs-artifacts
COPY --from=nodejs-install --chown=1000:1000 /opt/fnm /opt/fnm/

