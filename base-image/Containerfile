# =============================================================================
# FINAL — assemble all toolchains into workspace image
# =============================================================================
# The cote image must ship a full OS environment, not a scratch attack surface
# hadolint ignore=DL3007
FROM base AS final

# Assemble toolchains from artifact stages. Each artifact stage is a full
# root filesystem (base image + its tool), so merging them means one
# full-filesystem COPY per stage — deliberate: the cote image ships a full
# OS environment, not a scratch attack surface (docs/base-image.md).
# hadolint ignore=DL3067
COPY --link --from=crush-artifacts / /
