# Generate shell completions for CLI tools
RUN mkdir -p /root/.local/share/forgejo-cli && \
    echo '{"hosts":{}}' > /root/.local/share/forgejo-cli/keys.json && \
    mkdir -p /etc/bash_completion.d /usr/share/fish/vendor_completions.d /usr/share/zsh/site-functions && \
    # Bash completions
    for tool in cosign fj kubectl-cnpg cmctl agctl herdr nono; do \
      $tool completion bash > "/etc/bash_completion.d/$tool" 2>/dev/null || true; \
    done && \
    gh completion -s bash > /etc/bash_completion.d/gh 2>/dev/null || true && \
    bun completions bash > /etc/bash_completion.d/bun 2>/dev/null || true && \
    lola completions bash > /etc/bash_completion.d/lola 2>/dev/null || true && \
    /opt/fnm/fnm completions --shell bash > /etc/bash_completion.d/fnm 2>/dev/null || true && \
    uv generate-shell-completion bash > /etc/bash_completion.d/uv 2>/dev/null || true && \
    # Fish completions
    for tool in cosign fj kubectl-cnpg cmctl agctl buildah herdr nono; do \
      $tool completion fish > "/usr/share/fish/vendor_completions.d/${tool}.fish" 2>/dev/null || true; \
    done && \
    gh completion -s fish > /usr/share/fish/vendor_completions.d/gh.fish 2>/dev/null || true && \
    bun completions fish > /usr/share/fish/vendor_completions.d/bun.fish 2>/dev/null || true && \
    lola completions fish > /usr/share/fish/vendor_completions.d/lola.fish 2>/dev/null || true && \
    /opt/fnm/fnm completions --shell fish > /usr/share/fish/vendor_completions.d/fnm.fish 2>/dev/null || true && \
    uv generate-shell-completion fish > /usr/share/fish/vendor_completions.d/uv.fish 2>/dev/null || true && \
    # Zsh completions
    for tool in cosign fj kubectl-cnpg cmctl agctl buildah herdr nono; do \
      $tool completion zsh > "/usr/share/zsh/site-functions/_$tool" 2>/dev/null || true; \
    done && \
    gh completion -s zsh > /usr/share/zsh/site-functions/_gh 2>/dev/null || true && \
    bun completions zsh > /usr/share/zsh/site-functions/_bun 2>/dev/null || true && \
    lola completions zsh > /usr/share/zsh/site-functions/_lola 2>/dev/null || true && \
    /opt/fnm/fnm completions --shell zsh > /usr/share/zsh/site-functions/_fnm 2>/dev/null || true && \
    uv generate-shell-completion zsh > /usr/share/zsh/site-functions/_uv 2>/dev/null || true && \
    rm -rf /root/.local/share/forgejo-cli

# Go env
ARG GO_VERSION
ENV GO_VERSION=${GO_VERSION} \
    GOPATH=/go \
    GOROOT=/opt/go \
    PATH=/go/bin:/opt/go/bin:$PATH

# Rust env
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH

# Node.js (fnm) env
ARG FNM_VERSION
ARG NODE_VERSION
ENV FNM_DIR=/opt/fnm \
    PATH=/opt/fnm:/opt/fnm/aliases/default/bin:$PATH

# =============================================================================
# Workspace user (DevWorkspaces runs as non-root)
# =============================================================================
RUN useradd -m -u 1000 -U -s /bin/bash user && \
    mkdir -p /projects /home/user/.local /home/user/.config /home/user/.ssh && \
    chown -R user:user /home/user /projects

# Fixes for allowing rootless buildah and podman inside the container
RUN sed -i -e '/^user:/d' /etc/subuid /etc/subgid && \
    usermod --add-subuids 2000-65000 --add-subgids 2000-65000 user
ENV _BUILDAH_STARTED_IN_USERNS="" BUILDAH_ISOLATION=chroot
COPY <<-'EOT' /etc/containers/containers.conf
	[containers]
	netns="host"
	volumes = [
	  "/proc:/proc",
	]
	default_sysctls = []
	#userns="host"
	#ipcns="host"
	utsns="host"
	#cgroupns="host"
	#cgroups="disabled"
	log_driver = "k8s-file"
	[engine]
	cgroup_manager = "cgroupfs"
	events_logger="file"
	runtime="crun"
EOT

# Blank line after the heredoc terminator is required: hadolint's parser
# fails to read the next instruction otherwise
# hadolint ignore=DL3066
USER user
ENV PATH="/home/user/.local/bin:$PATH"
# Default shell prompt prefix marking the cote container; override per-session with SHELL_PROMPT_PREFIX
ENV SHELL_PROMPT_PREFIX="🏝️"
WORKDIR /projects
# Entrypoint: a small trampoline around catatonit (from podman). With no
# command the container runs `catatonit -P` — a pause container that just
# idles until stopped or exec'd into, with no child process in the process
# tree. With a command, catatonit is the init that reaps its zombies and
# forwards signals to it.
COPY --chown=user:user --chmod=0755 <<-'EOT' /usr/local/bin/cote-entrypoint
#!/bin/sh
# cote-entrypoint: catatonit as pause container or reaping init.
# No command: pause mode — no child process, no signal handling.
if [ "$#" -eq 0 ]; then
    exec /usr/libexec/podman/catatonit -P
fi
# Command given: the `--` keeps a leading dash from being parsed as a flag.
exec /usr/libexec/podman/catatonit -- "$@"
EOT

# Blank line after the heredoc terminator is required: hadolint's parser
# fails to read the next instruction otherwise
ENTRYPOINT ["/usr/local/bin/cote-entrypoint"]

# OCI well-known image labels (image-spec annotations.md). VERSION/REVISION/
# CREATED are passed by build.sh via --build-arg; the defaults keep ad-hoc
# `buildah build -f` invocations valid.
ARG VERSION=latest
ARG REVISION=unknown
ARG CREATED=

LABEL org.opencontainers.image.title="cote" \
      org.opencontainers.image.description="Base development environment for agentic developer workspaces" \
      org.opencontainers.image.authors="Joakim Nohlgård" \
      org.opencontainers.image.vendor="Snugmo" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.url="https://github.com/snugmo/cote" \
      org.opencontainers.image.documentation="https://github.com/snugmo/cote" \
      org.opencontainers.image.source="https://github.com/snugmo/cote.git" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      io.openshift.tags="dev,workspace,toolchain"
