# =============================================================================
# KUBESEAL — install kubeseal from bitnami/sealed-secrets release
# =============================================================================
FROM base AS kubeseal-install
ARG TARGETARCH
ARG KUBESEAL_VERSION=0.38.4
RUN ARCH=$TARGETARCH && \
    [ "$ARCH" = "amd64" ] && ARCH=amd64 || ARCH=arm64 && \
    curl -fsSL "https://github.com/bitnami/sealed-secrets/releases/download/v${KUBESEAL_VERSION}/kubeseal-${KUBESEAL_VERSION}-linux-${ARCH}.tar.gz" -o kubeseal.tar.gz && \
    curl -fsSL "https://github.com/bitnami/sealed-secrets/releases/download/v${KUBESEAL_VERSION}/kubeseal-${KUBESEAL_VERSION}-linux-${ARCH}.tar.gz.sig" -o kubeseal.tar.gz.sig && \
    curl -fsSL "https://github.com/bitnami/sealed-secrets/releases/download/v${KUBESEAL_VERSION}/cosign.pub" -o cosign.pub && \
    cosign verify-blob --key cosign.pub --signature kubeseal.tar.gz.sig kubeseal.tar.gz && \
    tar -xzf kubeseal.tar.gz -C /usr/local/bin kubeseal && \
    chmod +x /usr/local/bin/kubeseal && \
    rm -f kubeseal.tar.gz kubeseal.tar.gz.sig cosign.pub

# =============================================================================
# KUBECTL-LINSTOR — install Linstor kubectl plugin
# =============================================================================
FROM base AS kubectl-linstor-install
ARG TARGETARCH
ARG KUBECTL_LINSTOR_VERSION=0.3.2
RUN ARCH=$TARGETARCH && \
    [ "$ARCH" = "amd64" ] && ARCH=amd64 || ARCH=arm64 && \
    curl -fsSL "https://github.com/piraeusdatastore/kubectl-linstor/releases/download/v${KUBECTL_LINSTOR_VERSION}/kubectl-linstor_v${KUBECTL_LINSTOR_VERSION}_linux_${ARCH}.tar.gz" -o kubectl-linstor.tar.gz && \
    curl -fsSL "https://github.com/piraeusdatastore/kubectl-linstor/releases/download/v${KUBECTL_LINSTOR_VERSION}/kubectl-linstor_${KUBECTL_LINSTOR_VERSION}_checksums.txt" -o checksums.txt && \
    EXPECTED=$(grep "kubectl-linstor_v${KUBECTL_LINSTOR_VERSION}_linux_${ARCH}.tar.gz" checksums.txt | awk '{print $1}') && \
    echo "${EXPECTED}  kubectl-linstor.tar.gz" | sha256sum -c - && \
    tar -xzf kubectl-linstor.tar.gz -C /usr/local/bin kubectl-linstor && \
    chmod +x /usr/local/bin/kubectl-linstor && \
    rm -f kubectl-linstor.tar.gz checksums.txt

# =============================================================================
# CLOUDNATIVE-PG — install kubectl-cnpg plugin with SLSA provenance verification
# =============================================================================
FROM base AS cloudnative-pg-install
ARG TARGETARCH
ARG CLOUDNATIVE_PG_VERSION=1.30.0
RUN ARCH=$TARGETARCH && \
    [ "$ARCH" = "amd64" ] && ARCH=x86_64 || ARCH=arm64 && \
    curl -fsSL "https://github.com/cloudnative-pg/cloudnative-pg/releases/download/v${CLOUDNATIVE_PG_VERSION}/kubectl-cnpg_${CLOUDNATIVE_PG_VERSION}_linux_${ARCH}.tar.gz" -o kubectl-cnpg.tar.gz && \
    curl -fsSL "https://github.com/cloudnative-pg/cloudnative-pg/releases/download/v${CLOUDNATIVE_PG_VERSION}/multiple.intoto.jsonl" -o multiple.intoto.jsonl && \
    cosign verify-blob-attestation \
      --bundle multiple.intoto.jsonl \
      --type slsaprovenance \
      --certificate-oidc-issuer 'https://token.actions.githubusercontent.com' \
      --certificate-identity-regexp '^https://github\.com/slsa-framework/slsa-github-generator/' \
      --certificate-github-workflow-repository cloudnative-pg/cloudnative-pg \
      kubectl-cnpg.tar.gz && \
    tar -xzf kubectl-cnpg.tar.gz -C /usr/local/bin kubectl-cnpg && \
    chmod +x /usr/local/bin/kubectl-cnpg && \
    rm -f kubectl-cnpg.tar.gz multiple.intoto.jsonl

# =============================================================================
# CERT-MANAGER — install cmctl CLI with cosign verification
# =============================================================================
FROM base AS cert-manager-install
ARG TARGETARCH
ARG CERT_MANAGER_VERSION=2.5.0
RUN ARCH=$TARGETARCH && \
    [ "$ARCH" = "amd64" ] && ARCH=amd64 || ARCH=arm64 && \
    curl -fsSL "https://github.com/cert-manager/cmctl/releases/download/v${CERT_MANAGER_VERSION}/cmctl_linux_${ARCH}.tar.gz" -o cmctl.tar.gz && \
    curl -fsSL "https://github.com/cert-manager/cmctl/releases/download/v${CERT_MANAGER_VERSION}/checksums.txt" -o checksums.txt && \
    curl -fsSL "https://github.com/cert-manager/cmctl/releases/download/v${CERT_MANAGER_VERSION}/checksums.txt.cosign.bundle" -o checksums.txt.cosign.bundle && \
    cosign verify-blob \
      --certificate-identity 'https://github.com/cert-manager/cmctl/.github/workflows/release.yaml@refs/tags/v'"${CERT_MANAGER_VERSION}" \
      --certificate-oidc-issuer 'https://token.actions.githubusercontent.com' \
      --bundle checksums.txt.cosign.bundle \
      checksums.txt && \
    EXPECTED=$(grep "cmctl_linux_${ARCH}.tar.gz" checksums.txt | awk '{print $1}') && \
    echo "${EXPECTED}  cmctl.tar.gz" | sha256sum -c - && \
    tar -xzf cmctl.tar.gz -C /usr/local/bin cmctl && \
    chmod +x /usr/local/bin/cmctl && \
    rm -f cmctl.tar.gz checksums.txt checksums.txt.cosign.bundle

# =============================================================================
# AGENTGATEWAY — install agctl CLI
# =============================================================================
FROM base AS agentgateway-install
ARG TARGETARCH
ARG AGENTGATEWAY_VERSION=1.3.1
RUN ARCH=$TARGETARCH && \
    [ "$ARCH" = "amd64" ] && ARCH=amd64 || ARCH=arm64 && \
    curl -fsSL "https://github.com/agentgateway/agentgateway/releases/download/v${AGENTGATEWAY_VERSION}/agctl-linux-${ARCH}" -o /usr/local/bin/agctl && \
    curl -fsSL "https://github.com/agentgateway/agentgateway/releases/download/v${AGENTGATEWAY_VERSION}/agctl-linux-${ARCH}.sha256" -o agctl.sha256 && \
    EXPECTED=$(cat agctl.sha256 | awk '{print $1}') && \
    echo "${EXPECTED}  /usr/local/bin/agctl" | sha256sum -c - && \
    chmod +x /usr/local/bin/agctl && \
    rm -f agctl.sha256

# =============================================================================
# EXTRAS — artifact stages for single-binary tools in /usr/local/bin
# =============================================================================
FROM scratch AS forgejo-cli-artifacts
COPY --from=forgejo-cli-install /usr/local/bin/fj /usr/local/bin/

FROM scratch AS kubeseal-artifacts
COPY --from=kubeseal-install /usr/local/bin/kubeseal /usr/local/bin/

FROM scratch AS kubectl-linstor-artifacts
COPY --from=kubectl-linstor-install /usr/local/bin/kubectl-linstor /usr/local/bin/

FROM scratch AS cloudnative-pg-artifacts
COPY --from=cloudnative-pg-install /usr/local/bin/kubectl-cnpg /usr/local/bin/

FROM scratch AS cert-manager-artifacts
COPY --from=cert-manager-install /usr/local/bin/cmctl /usr/local/bin/

FROM scratch AS agentgateway-artifacts
COPY --from=agentgateway-install /usr/local/bin/agctl /usr/local/bin/

# =============================================================================
# FINAL — assemble all toolchains into workspace image
# =============================================================================
FROM base AS final

# Assemble toolchains from artifact stages
COPY --link --from=crush-artifacts / /
COPY --link --from=nodejs-artifacts / /
COPY --link --from=bun-artifacts / /
COPY --link --from=go-artifacts / /
COPY --link --from=rust-artifacts / /
COPY --link --from=python-artifacts / /
COPY --link --from=forgejo-cli-artifacts / /
COPY --link --from=kubeseal-artifacts / /
COPY --link --from=kubectl-linstor-artifacts / /
COPY --link --from=cloudnative-pg-artifacts / /
COPY --link --from=cert-manager-artifacts / /
COPY --link --from=agentgateway-artifacts / /
COPY --link --from=github-cli-artifacts / /

# Generate shell completions for CLI tools
RUN mkdir -p /etc/bash_completion.d /usr/share/fish/vendor_completions.d /usr/share/zsh/site-functions && \
    # Bash completions
    for tool in cosign fj kubectl-cnpg cmctl agctl; do \
      $tool completion bash > "/etc/bash_completion.d/$tool" 2>/dev/null || true; \
    done && \
    /opt/github-cli/bin/gh completion -s bash > /etc/bash_completion.d/gh 2>/dev/null || true && \
    /opt/fnm/fnm completions --shell bash > /etc/bash_completion.d/fnm 2>/dev/null || true && \
    /opt/uv/bin/uv generate-shell-completion bash > /etc/bash_completion.d/uv 2>/dev/null || true && \
    # Fish completions
    for tool in cosign fj kubectl-cnpg cmctl agctl; do \
      $tool completion fish > "/usr/share/fish/vendor_completions.d/${tool}.fish" 2>/dev/null || true; \
    done && \
    /opt/github-cli/bin/gh completion -s fish > /usr/share/fish/vendor_completions.d/gh.fish 2>/dev/null || true && \
    /opt/fnm/fnm completions --shell fish > /usr/share/fish/vendor_completions.d/fnm.fish 2>/dev/null || true && \
    /opt/uv/bin/uv generate-shell-completion fish > /usr/share/fish/vendor_completions.d/uv.fish 2>/dev/null || true && \
    # Zsh completions
    for tool in cosign fj kubectl-cnpg cmctl agctl; do \
      $tool completion zsh > "/usr/share/zsh/site-functions/_$tool" 2>/dev/null || true; \
    done && \
    /opt/github-cli/bin/gh completion -s zsh > /usr/share/zsh/site-functions/_gh 2>/dev/null || true && \
    /opt/fnm/fnm completions --shell zsh > /usr/share/zsh/site-functions/_fnm 2>/dev/null || true && \
    /opt/uv/bin/uv generate-shell-completion zsh > /usr/share/zsh/site-functions/_uv 2>/dev/null || true

# Go env
ARG GO_VERSION
ENV GO_VERSION=${GO_VERSION} \
    GOPATH=/go \
    PATH=/go/bin:/opt/go/bin:$PATH

# Rust env
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH

# Node.js (fnm) env
ARG FNM_VERSION
ARG NODE_VERSION
ENV FNM_DIR=/opt/fnm \
    PATH=/opt/fnm:/opt/fnm/aliases/default/bin:$PATH

# =============================================================================
# Workspace user (DevWorkspaces runs as non-root)
# =============================================================================
RUN useradd -m -u 1000 -U -s /bin/bash user && \
    mkdir -p /projects /home/user/.local /home/user/.config /home/user/.ssh \
             /go /opt/cargo /opt/rustup && \
    chown -R user:user /home/user /projects /go /opt/cargo /opt/rustup /opt/fnm /opt/bun /opt/crush /opt/uv /opt/github-cli

# Fixes for allowing rootless buildah and podman inside the container
RUN sed -i -e '/^user:/d' /etc/subuid /etc/subgid && \
    usermod --add-subuids 2000-65000 --add-subgids 2000-65000 user
ENV _BUILDAH_STARTED_IN_USERNS="" BUILDAH_ISOLATION=chroot
COPY <<-'EOT' /etc/containers/containers.conf
	[containers]
	netns="host"
