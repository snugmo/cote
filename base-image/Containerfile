# hadolint ignore=DL3067
COPY --link --from=uv-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=python-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=forgejo-cli-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=kubeseal-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=kubectl-linstor-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=cloudnative-pg-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=cert-manager-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=agentgateway-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=github-cli-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=mcp-cli-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=marksman-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=helm-ls-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=tofu-ls-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=protols-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=herdr-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=ast-grep-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=shfmt-artifacts / /
# hadolint ignore=DL3067
COPY --link --from=kubeconform-artifacts / /
# hadolint ignore=DL3067
