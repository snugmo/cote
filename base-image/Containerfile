# Base development environment image for DevWorkspaces Operator
# Provides universal toolchain: compilers, package managers, shell utils, LSP servers
# IDEs are excluded — they are added as separate Devfile components (e.g., Eclipse Che plugins)
#
# Build strategy: parallel install stages → scratch artifact stages → final assembly.
# Each toolchain installs to standard paths, then a FROM scratch stage captures
# only the files needed. Final image assembles via single COPY --link per toolchain.

ARG TARGETARCH
# =============================================================================
# BASE — system packages only (rarely changes)
# =============================================================================
FROM registry.fedoraproject.org/fedora:44 AS base

# Prevent interactive prompts during package installation
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    FORCE_NONINTERACTIVE=1

RUN mkdir -p /etc/yum.repos.d && \
    dnf install --setopt=install_weak_deps=false --nodocs --setopt=tsflags=nodocs -y \
        dnf-plugins-core && \
    # Reinstall shadow-utils to fix file caps on newuidmap, newgidmap
    dnf reinstall -y shadow-utils && \
    dnf install --setopt=install_weak_deps=false --nodocs --setopt=tsflags=nodocs -y \
        # Base shell tools
        diffutils findutils lsof moreutils openssl patch procps time util-linux which \
        # Build tools
        bison byacc clang clang-libs clang-tools-extra cmake flex gcc gcc-c++ gdb llvm make meson m4 ninja-build xxd \
        # Shells & editors
        bash bash-completion bash-color-prompt fish nano vim vim-default-editor zsh \
        # Version control & collaboration
        git git-annex git-delta git-filter-repo git-lfs \
        # HTTP & download tools
        curl openssh-clients wget wget2 \
        # Text processing & utilities
        bat file gawk jq less sed strace tree \
        # Python ecosystem
        python3 python3-devel python3-pip python3-wheel \
        # Rust
        rustup \
        # Language servers & search tools
        fd-find ripgrep the_silver_searcher yq \
        # Identity, encryption, integrity
        age ca-certificates gnupg2 gpgme sequoia-sop sequoia-sq \
        # Misc dev utilities
        7zip gzip rsync sqlite tar tmux unzip xdelta xz xxhash zstd \
        # Network tools
        bind-utils grpcurl iproute iputils knot-utils net-tools nmap nmap-ncat oidc-agent-cli socat tcpdump \
        # Markdown renderer
        glow \
        # Image tools
        ImageMagick GraphicsMagick libsixel-utils \
        # Container tools
        podman buildah skopeo fuse-overlayfs \
        # Kubernetes utilities
        kustomize helm kubernetes1.36-client awscli2 opentofu \
        # Misc extras
        foot-terminfo kitty-terminfo \
    && dnf clean all

# Install cosign for signature verification (available to all downstream stages)
ARG TARGETARCH
ARG COSIGN_VERSION=3.1.1
RUN curl -fsSL "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-${TARGETARCH}" -o /usr/local/bin/cosign && \
    chmod +x /usr/local/bin/cosign

# =============================================================================
# CRUSH — install from GitHub release with cosign verification
# =============================================================================
FROM base AS crush-install
ARG TARGETARCH
ARG CRUSH_VERSION=0.83.0
RUN ARCH=$TARGETARCH && \
    [ "$ARCH" = "amd64" ] && ARCH=x86_64 && \
    curl -fsSL "https://github.com/charmbracelet/crush/releases/download/v${CRUSH_VERSION}/crush_${CRUSH_VERSION}_Linux_${ARCH}.tar.gz" -o crush.tar.gz && \
    curl -fsSL "https://github.com/charmbracelet/crush/releases/download/v${CRUSH_VERSION}/checksums.txt" -o checksums.txt && \
    curl -fsSL "https://github.com/charmbracelet/crush/releases/download/v${CRUSH_VERSION}/checksums.txt.sigstore.json" -o checksums.txt.sigstore.json && \
    cosign verify-blob \
      --certificate-identity 'https://github.com/charmbracelet/meta/.github/workflows/goreleaser.yml@refs/heads/main' \
      --certificate-oidc-issuer 'https://token.actions.githubusercontent.com' \
      --bundle checksums.txt.sigstore.json \
      checksums.txt && \
    EXPECTED=$(grep "crush_${CRUSH_VERSION}_Linux_${ARCH}.tar.gz$" checksums.txt | awk '{print $1}') && \
    echo "${EXPECTED}  crush.tar.gz" | sha256sum -c - && \
    mkdir -p /opt/crush/bin /etc/bash_completion.d /usr/share/fish/vendor_completions.d /usr/share/zsh/site-functions && \
    tar -xzf crush.tar.gz -C /opt/crush/bin "crush_${CRUSH_VERSION}_Linux_${ARCH}/crush" && \
    mv /opt/crush/bin/crush_${CRUSH_VERSION}_Linux_${ARCH}/crush /opt/crush/bin/crush && \
    rmdir /opt/crush/bin/crush_${CRUSH_VERSION}_Linux_${ARCH} && \
    tar -xzf crush.tar.gz "crush_${CRUSH_VERSION}_Linux_${ARCH}/completions/crush.bash" -O > /etc/bash_completion.d/crush && \
    tar -xzf crush.tar.gz "crush_${CRUSH_VERSION}_Linux_${ARCH}/completions/crush.fish" -O > /usr/share/fish/vendor_completions.d/crush.fish && \
    tar -xzf crush.tar.gz "crush_${CRUSH_VERSION}_Linux_${ARCH}/completions/crush.zsh" -O > /usr/share/zsh/site-functions/_crush && \
    rm -f crush.tar.gz checksums.txt checksums.txt.sigstore.json

FROM scratch AS crush-artifacts
COPY --from=crush-install /opt/crush /opt/crush/
COPY --from=crush-install /etc/bash_completion.d/crush /etc/bash_completion.d/
COPY --from=crush-install /usr/share/fish/vendor_completions.d/crush.fish /usr/share/fish/vendor_completions.d/
COPY --from=crush-install /usr/share/zsh/site-functions/_crush /usr/share/zsh/site-functions/

# =============================================================================
# NODEJS — install
# =============================================================================
FROM base AS nodejs-install
ARG TARGETARCH
ARG FNM_VERSION=1.39.0
ARG NODE_VERSION=24
ENV FNM_DIR=/opt/fnm \
    PATH=${FNM_DIR}:$PATH

RUN ARCH=$TARGETARCH && \
    [ "$ARCH" = "arm64" ] && ARCH=arm64 || ARCH=linux && \
    mkdir -p "${FNM_DIR}" && \
    curl -fsSL "https://github.com/Schniz/fnm/releases/download/v${FNM_VERSION}/fnm-${ARCH}.zip" -o fnm.zip && \
    unzip -q fnm.zip -d "${FNM_DIR}" && \
    rm -f fnm.zip && \
    "${FNM_DIR}/fnm" install "${NODE_VERSION}" && \
    "${FNM_DIR}/fnm" default "${NODE_VERSION}" && \
    source <("${FNM_DIR}/fnm" env --shell bash) && \
    npm install -g \
        typescript \
        typescript-language-server \
        eslint \
        prettier \
        yaml-language-server

FROM scratch AS nodejs-artifacts
COPY --from=nodejs-install /opt/fnm /opt/fnm/

# =============================================================================
# BUN — install from GitHub release with checksum verification
# =============================================================================
FROM base AS bun-install
ARG TARGETARCH
ARG BUN_VERSION=1.3.14
COPY <<'EOT' robobun.asc
-----BEGIN PGP PUBLIC KEY BLOCK-----

mDMEY9GQFhYJKwYBBAHaRw8BAQdAkppAqaXl0RkROz6NfdvlwYd2UuUVfHLk2NNY
IzEdnT+0GVJvYm9idW4gPHJvYm9idW5Ab3Zlbi5zaD6IkwQTFgoAOxYhBPPcwIqF
csB0mz4YiI6rTUCnsitZBQJj0ZAWAhsDBQsJCAcCAiICBhUKCQgLAgQWAgMBAh4H
AheAAAoJEI6rTUCnsitZ96UBAMvwCLD6Ud1RZkpvvnGUU+idHt2hcNmYU2d0XxDI
HQ0rAQCA9VFOtjZefQkfhDzgIgnEEdSFXaMiyY+D+LP8awNMCrg4BGPRkBYSCisG
AQQBl1UBBQEBB0BpfePYSOEx8PihYkNXjlK5YT89CGHjEK5etleaB9i6OwMBCAeI
eAQYFgoAIBYhBPPcwIqFcsB0mz4YiI6rTUCnsitZBQJj0ZAWAhsMAAoJEI6rTUCn
sitZvhAA/j4SQxOCLheRG86A2181WAP4qLS1qxSw+fCf28DgiPfbAQCL0kcel+M9
qbRIlMnwn6TwlQgN9w1qqlSnA9CbKXT9Aw==
=dGV6
-----END PGP PUBLIC KEY BLOCK-----
EOT
RUN ARCH=$TARGETARCH && \
    [ "$ARCH" = "amd64" ] && ARCH=x64 || ARCH=aarch64 && \
    mkdir -p /opt/bun/bin && \
    gpg --batch --import robobun.asc && \
    curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${ARCH}.zip" -o bun.zip && \
    curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/SHASUMS256.txt.asc" -o SHASUMS256.txt.asc && \
    gpg --batch --decrypt --output SHASUMS256.txt SHASUMS256.txt.asc && \
    EXPECTED=$(grep "bun-linux-${ARCH}.zip" SHASUMS256.txt | awk '{print $1}') && \
    echo "${EXPECTED}  bun.zip" | sha256sum -c - && \
    unzip -q -j bun.zip -d /opt/bun/bin && \
    chmod +x /opt/bun/bin/bun && \
    rm -f bun.zip SHASUMS256.txt && \
    SHELL=bash /opt/bun/bin/bun completions > /etc/bash_completion.d/bun && \
    SHELL=fish /opt/bun/bin/bun completions > /usr/share/fish/vendor_completions.d/bun.fish && \
    SHELL=zsh /opt/bun/bin/bun completions > /usr/share/zsh/site-functions/_bun

FROM scratch AS bun-artifacts
COPY --from=bun-install /opt/bun /opt/bun/
COPY --from=bun-install /etc/bash_completion.d/bun /etc/bash_completion.d/
COPY --from=bun-install /usr/share/fish/vendor_completions.d/bun.fish /usr/share/fish/vendor_completions.d/
COPY --from=bun-install /usr/share/zsh/site-functions/_bun /usr/share/zsh/site-functions/

# =============================================================================
# GO — install
# =============================================================================
FROM base AS go-install
ARG TARGETARCH
ARG GO_VERSION=1.26.5
ENV GO_VERSION=${GO_VERSION} \
    GOPATH=/go \
    PATH=/go/bin:/opt/go/bin:$PATH

RUN curl -fsSL "https://golang.org/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" | \
    tar -C /opt -xz && \
    mkdir -p $GOPATH/bin && \
    go install golang.org/x/tools/gopls@latest && \
    go install github.com/nametake/golangci-lint-langserver@latest

FROM scratch AS go-artifacts
COPY --from=go-install /opt/go /opt/go/
COPY --from=go-install /go /go/

# =============================================================================
# RUST — install
# =============================================================================
FROM base AS rust-install
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH

RUN rustup-init -y --profile=default --default-toolchain stable && \
    rustup component add rust-analyzer

FROM scratch AS rust-artifacts
COPY --from=rust-install /opt/rustup /opt/rustup/
COPY --from=rust-install /opt/cargo /opt/cargo/

# =============================================================================
# PYTHON — install
# =============================================================================
FROM base AS python-install
ARG TARGETARCH
ARG UV_VERSION=0.11.28
RUN ARCH=$TARGETARCH && \
    [ "$ARCH" = "amd64" ] && ARCH=x86_64-unknown-linux-gnu || ARCH=aarch64-unknown-linux-gnu && \
    curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${ARCH}.tar.gz" -o "uv-${ARCH}.tar.gz" && \
    curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${ARCH}.tar.gz.sha256" -o uv.sha256 && \
    sha256sum -c uv.sha256 && \
    mkdir -p /opt/uv/bin && \
    tar -xzf "uv-${ARCH}.tar.gz" -C /opt/uv/bin --strip-components=1 && \
    rm -f "uv-${ARCH}.tar.gz" uv.sha256 && \
    pip3 install --no-cache-dir --break-system-packages \
    pylint \
    black \
    ruff \
    mypy \
    pyright \
    ruff-lsp

FROM scratch AS python-artifacts
COPY --from=python-install /opt/uv /opt/uv/
COPY --from=python-install /usr/local /usr/local/

