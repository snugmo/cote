# syntax=docker/dockerfile:1
# PiG (Pi in Go) extension image
# Installs PiG (https://pi-in-go.dev, github.com/MichaelKinsy/PiG) — a faithful
# Go implementation of the Pi coding agent — on top of the cote base
# image.
#
# Build:
#   ./build.sh                          # Build only
#   ./build.sh push <registry>          # Build and push
#
# Usage in Devfile:
#   image: <registry>/cote-pi-in-go:<tag>

ARG BASE_IMAGE=quay.io/snugmo/cote:latest-base
FROM ${BASE_IMAGE}

# Both named users exist in the image (root is universal, user is created in
# the base image), so DL3066's host-resolution concern is a false positive.
# hadolint ignore=DL3066
USER root

ARG PIG_VERSION=0.7.0

# Install the official PiG npm package globally. @pi-in-go/pig is a thin Node
# launcher (bin/pig.js) whose optionalDependencies pull in the native pig
# binary for the build platform (@pi-in-go/pig-linux-<arch>), so npm selects the
# correct architecture automatically and no lifecycle scripts are required (the
# package ships without a postinstall). npm verifies the published tarball
# integrity (sha512) against the registry. PiG 0.7.0 tracks Pi 1.5.0.
RUN npm install -g --ignore-scripts --no-audit --no-fund \
      "@pi-in-go/pig@${PIG_VERSION}" && \
    pig --version

# Create PiG's config directory for the workspace user and bake in the example LLM
# provider (a keyless OpenAI-compatible gateway at
# https://llm.example.com/v1) as the default model, so the agent is usable out of the
# box. PiG keeps its state under ~/.pig (agent dir ~/.pig/agent) and never reads
# or writes ~/.pi.
RUN mkdir -p /home/user/.pig/agent && \
    chown -R user:user /home/user/.pig

COPY --chown=user:user models.json settings.json /home/user/.pig/agent/

# hadolint ignore=DL3066
USER user

# OCI well-known image labels (image-spec annotations.md). VERSION/REVISION/
# CREATED are passed by build.sh via --build-arg; BASE_IMAGE is the resolved
# reference of the base image this image extends.
ARG VERSION=latest
ARG REVISION=unknown
ARG CREATED=
ARG BASE_IMAGE=quay.io/snugmo/cote:latest-base

LABEL org.opencontainers.image.title="cote-pi-in-go" \
      org.opencontainers.image.description="cote dev workspace with PiG (Pi in Go) terminal coding agent and a built-in keyless example LLM provider" \
      org.opencontainers.image.authors="Joakim Nohlgård" \
      org.opencontainers.image.vendor="Snugmo" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.url="https://github.com/snugmo/cote" \
      org.opencontainers.image.documentation="https://github.com/snugmo/cote" \
      org.opencontainers.image.source="https://github.com/snugmo/cote.git" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      io.openshift.tags="dev,workspace,pig,go,agent"
