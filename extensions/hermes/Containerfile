# Hermes Agent extension image with ACP support
# Installs Hermes agent as a coding agent with Agent Communication Protocol (ACP)
# for IDE integration (VS Code, Zed, JetBrains).
#
# Build:
#   ./build.sh                          # Build only
#   ./build.sh push <registry>          # Build and push
#
# Usage in Devfile:
#   image: <registry>/cote-hermes:<tag>

ARG BASE_IMAGE=ghcr.io/snugmo/cote:latest-base
FROM ${BASE_IMAGE}

USER root

ARG HERMES_VERSION=v2026.9.24

# Shallow clone Hermes agent repo and install with ACP extra into system Python.
# Using git clone + editable install instead of pip package (pip installs are
# explicitly unsupported upstream). Browser tools, setup wizard, and bundled
# skills are skipped — users configure credentials and browser tools at runtime.
RUN git clone --depth 1 --branch "${HERMES_VERSION}" \
      https://github.com/NousResearch/hermes-agent.git /opt/hermes-agent && \
    cd /opt/hermes-agent && \
    # Create venv with system Python via uv (already in base image)
    uv venv .venv --python 3 && \
    # Install Hermes with ACP extra only (no browser, no matrix, no RL)
    UV_PROJECT_ENVIRONMENT=.venv uv pip install -e '.[acp]' && \
    # Create hermes launcher in /usr/local/bin (FHS layout, matches upstream)
    mkdir -p /usr/local/bin && \
    printf '#!/usr/bin/env bash\nunset PYTHONPATH\nunset PYTHONHOME\nexec "/opt/hermes-agent/.venv/bin/hermes" "$@"\n' > /usr/local/bin/hermes && \
    chmod +x /usr/local/bin/hermes && \
    # Verify installation
    hermes --version && \
    hermes acp --version

# Create Hermes data directory for the workspace user
RUN mkdir -p /home/user/.hermes/skills && \
    chown -R user:user /home/user/.hermes

USER user

# Set environment for Hermes
ENV HERMES_HOME=/home/user/.hermes

# OCI well-known image labels (image-spec annotations.md). VERSION/REVISION/
# CREATED are passed by build.sh via --build-arg; BASE_IMAGE is the resolved
# reference of the base image this image extends.
ARG VERSION=latest
ARG REVISION=unknown
ARG CREATED=
ARG BASE_IMAGE=ghcr.io/snugmo/cote:latest-base

LABEL org.opencontainers.image.title="cote-hermes" \
      org.opencontainers.image.description="cote dev workspace with Hermes agent and ACP support for IDE integration" \
      org.opencontainers.image.authors="Joakim Nohlgård" \
      org.opencontainers.image.vendor="Snugmo" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.url="https://github.com/snugmo/cote" \
      org.opencontainers.image.documentation="https://github.com/snugmo/cote" \
      org.opencontainers.image.source="https://github.com/snugmo/cote.git" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      io.openshift.tags="dev,workspace,hermes,acp,agent"
