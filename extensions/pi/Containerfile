# Pi coding agent extension image
# Installs the Pi coding agent (https://pi.dev, github.com/earendil-works/pi)
# as a global npm package on top of the cote base image.
#
# Build:
#   ./build.sh                          # Build only
#   ./build.sh push <registry>          # Build and push
#
# Usage in Devfile:
#   image: <registry>/cote-pi:<tag>

ARG BASE_IMAGE=ghcr.io/snugmo/cote:latest-base
FROM ${BASE_IMAGE}

USER root

ARG PI_VERSION=1.3.0

# Install the official Pi coding agent npm package globally (upstream's
# documented install). --ignore-scripts is recommended by upstream: pi does
# not require dependency lifecycle scripts, and the published package ships
# an npm-shrinkwrap.json pinning all transitive dependencies. npm verifies
# the published tarball integrity (sha512) against the registry.
RUN npm install -g --ignore-scripts --no-audit --no-fund \
      "@earendil-works/pi-coding-agent@${PI_VERSION}" && \
    pi --version

# Create Pi config directory for the workspace user and bake in the example
# LLM provider (keyless OpenAI-compatible endpoint) as the default model
RUN mkdir -p /home/user/.pi/agent && \
    chown -R user:user /home/user/.pi

COPY --chown=user:user models.json settings.json /home/user/.pi/agent/

USER user

# OCI well-known image labels (image-spec annotations.md). VERSION/REVISION/
# CREATED are passed by build.sh via --build-arg; BASE_IMAGE is the resolved
# reference of the base image this image extends.
ARG VERSION=latest
ARG REVISION=unknown
ARG CREATED=
ARG BASE_IMAGE=ghcr.io/snugmo/cote:latest-base

LABEL org.opencontainers.image.title="cote-pi" \
      org.opencontainers.image.description="cote dev workspace with Pi coding agent for terminal, RPC, and SDK integrations and a built-in keyless example LLM provider" \
      org.opencontainers.image.authors="Joakim Nohlgård" \
      org.opencontainers.image.vendor="Snugmo" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.url="https://github.com/snugmo/cote" \
      org.opencontainers.image.documentation="https://github.com/snugmo/cote" \
      org.opencontainers.image.source="https://github.com/snugmo/cote.git" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      io.openshift.tags="dev,workspace,pi,agent"
